# ─── Development server ───────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your local setup.
# .env is gitignored — never commit it.

# Where Vite's dev server should proxy /api/* requests.
# Must be reachable from your machine (not the browser).
VITE_API_ROOT=http://localhost:8080

# Where Vite's dev server should proxy /auth/* requests.
VITE_AUTHENTICATION_ROOT=http://localhost:3000

# Hostname the dev server accepts. npm run dev binds using the --host flag.
ALLOWED_HOST=localhost

# Optional: exact origin allowed to access the dev server, such as
# http://localhost:5173. Leave empty to use Vite's local-origin defaults.
CORS_ORIGIN=

# ─── Build-time (optional overrides) ─────────────────────────────────────────
# These are baked into the JS bundle. Leave them as /api and /auth when nginx
# handles proxying (the default for both Docker and .deb deployments).
# Only set absolute URLs here if you are serving the app without nginx.
#
VITE_API_URL=/api
VITE_AUTHENTICATION_URL=/auth
# Note: this app signs users up through the HomeBranch authentication service, not directly through Supabase.
# Set VITE_AUTHENTICATION_URL/VITE_AUTHENTICATION_ROOT to your auth service; Supabase URL/anon keys alone will not enable email signup.

# Number of books to load per page in the library.
VITE_ITEMS_PER_PAGE=20

# Show the sign-up page. The authentication service also controls registration.
VITE_SIGNUP_ENABLED=true
